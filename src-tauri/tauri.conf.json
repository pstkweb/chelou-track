{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chelou-track",
  "version": "0.1.3",
  "identifier": "com.chelou.track",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzRDY5MzFFMDFBMzFEMTcKUldRWEhhTUJIcFBXRXdkdnNKdDZrWHlvdmcvdEpjR3BjdVc3c1BDakdOc3FRc1RySjZxVkpDcFkK",
      "endpoints": [
        "https://github.com/pstkweb/chelou-track/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Chelou Track",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Music",
    "shortDescription": "Lecteur de méthodes de guitare : vidéos et tablatures synchronisées avec un backing track.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}